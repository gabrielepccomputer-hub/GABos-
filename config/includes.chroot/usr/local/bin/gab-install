#!/bin/bash
FILE=$1

if [[ -z "$FILE" ]]; then
    zenity --error --text="Comandante, seleziona un file .deb o .AppImage!"
    exit 1
fi

if [[ "$FILE" == *.deb ]]; then
    zenity --info --text="Installazione pacchetto spaziale: $FILE"
    sudo gdebi -n "$FILE"
elif [[ "$FILE" == *.AppImage ]]; then
    zenity --info --text="Configurazione modulo AppImage: $FILE"
    chmod +x "$FILE"
    ./"$FILE"
else
    zenity --error --text="Formato non riconosciuto dal sistema GAB."
fi
